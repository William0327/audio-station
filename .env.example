# install.sh creates .env with a random private gateway token. Never commit .env.
DEPLOYMENT_MODE=managed
STATION_INSTANCE=audio-station
BIND_ADDRESS=127.0.0.1
CONTROLLER_PORT=8080
GATEWAY_TOKEN=
MAX_UPLOAD_MB=500
APPLIO_PORT=6969
APPLIO_PUBLIC_URL=http://localhost:6969
# Optional advanced external mode mappings. See docs/migration.md.
# HOST_DATA_DIR=
# HOST_INPUT_DIR=
# HOST_OUTPUT_DIR=
# HOST_MODELS_DIR=
# SEPARATOR_CONTAINER=existing-separator
# APPLIO_CONTAINER=existing-applio
# WORKLOAD_NETWORK=existing-network
# WORKLOAD_NETWORK_EXTERNAL=true
# SEPARATOR_INPUT_DIR=/input
# SEPARATOR_OUTPUT_DIR=/output
# SEPARATOR_MODELS_DIR=/models
# SEPARATOR_BINARY=audio-separator
# APPLIO_HEALTH_URL=http://existing-applio:6969
